{
    "name": "sebastianpopp/laravel-uptime-kuma-push",
    "description": "Automatically push uptime checks to Uptime Kuma.",
    "keywords": [
        "Sebastian Popp",
        "laravel",
        "laravel-uptime-kuma-push"
    ],
    "homepage": "https://github.com/sebastianpopp/laravel-uptime-kuma-push",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Sebastian Popp",
            "email": "git@sebastianpopp.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/sebastianpopp/laravel-uptime-kuma-push/issues",
        "source": "https://github.com/sebastianpopp/laravel-uptime-kuma-push"
    },
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "SebastianPopp\\LaravelUptimeKumaPush\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SebastianPopp\\LaravelUptimeKumaPush\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SebastianPopp\\LaravelUptimeKumaPush\\LaravelUptimeKumaPushServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
